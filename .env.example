# ─────────────────────────────────────────────────────────────
#  fail2ban-telegram-notifier — plantilla de configuración
#  Copia este fichero a `.env` y rellena los valores.
#  TODAS las variables están documentadas aquí.
# ─────────────────────────────────────────────────────────────

# ── Comunes ──────────────────────────────────────────────────
# Transporte hacia Telegram: "direct" (Bot API) o "gateway" (tg-gateway local).
# Por defecto: direct.
TRANSPORT=direct

# Chat (o grupo) donde se envían las notificaciones. OBLIGATORIO.
# Consejo: usa el comando /chat_id del bot para descubrirlo.
TELEGRAM_CHAT_ID=

# Tema/hilo dentro del grupo (foros de Telegram). Opcional.
# NOTA: en TRANSPORT=gateway el tg-gateway actual IGNORA este campo
# (su /api/send no acepta message_thread_id); solo se aplica en direct.
TELEGRAM_TOPIC_ID=

# Modo de parseo de los mensajes. Por defecto: HTML.
TELEGRAM_PARSE_MODE=HTML

# Idioma de los mensajes: "es" (por defecto) o "en".
MESSAGE_LANG=es

# ── Transporte direct (Bot API de Telegram) ──────────────────
# Token del bot (de @BotFather). OBLIGATORIO si TRANSPORT=direct.
TELEGRAM_BOT_TOKEN=

# URL base de la Bot API. Solo se cambia para self-hosting o tests.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Timeout del long-polling de getUpdates, en segundos. Por defecto: 30.
TELEGRAM_POLL_TIMEOUT=30

# ── Transporte gateway (tg-gateway local) ────────────────────
# URL del tg-gateway. Por defecto: http://127.0.0.1:4000
TG_GATEWAY_URL=http://127.0.0.1:4000

# Interfaz donde este bot escucha los updates reenviados por el gateway.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=14120

# Cada cuánto re-registrar los comandos en el gateway, en ms. El gateway no
# persiste handlers en disco: si reinicia, hay que volver a registrarlos.
# Por defecto: 60000. 0 lo desactiva.
GATEWAY_REREGISTER_MS=60000

# ── fail2ban ─────────────────────────────────────────────────
# Ruta del log de fail2ban que se sigue (tail). Por defecto: /var/log/fail2ban.log
FAIL2BAN_LOG_PATH=/var/log/fail2ban.log

# Jails cuyos bans se consideran "permanentes" (texto distinto y contador
# de reincidentes). Separadas por coma. Por defecto: recidive
F2B_PERMANENT_JAILS=recidive

# Jails a ignorar por completo (no se notifican). Separadas por coma. Opcional.
F2B_IGNORE_JAILS=

# IPs a ignorar por completo (no se notifican). Separadas por coma. Opcional.
F2B_IGNORE_IPS=

# Suprimir los "Unban" masivos que fail2ban emite al apagarse/reiniciarse
# (evita desbaneos falsos). Por defecto: true.
F2B_SUPPRESS_SHUTDOWN_FLUSH=true

# Intervalo de sondeo del fichero de log, en ms. Por defecto: 1000.
F2B_POLL_INTERVAL_MS=1000

# ── Notificaciones por lote (resumen periódico, opcional) ────
# Modo de notificación: "instant" (un mensaje por evento, por defecto) o
# "batch" (acumula eventos y envía un resumen de una sola línea por ventana).
# Sin esta variable (o con "instant") todo sigue como siempre.
NOTIFY_MODE=instant

# Ventana del resumen en segundos. Las ventanas se alinean al reloj local
# (con 3600 salen a las :00; con 900 a :00/:15/:30/:45). Debe dividir a 86400.
# Por defecto: 3600.
BATCH_WINDOW_SEC=3600

# "true" añade las IPs en spoiler agrupadas por jail. Por defecto: false.
BATCH_SHOW_IPS=false

# Si > 0, envía el resumen antes de tiempo al alcanzar ese nº de eventos
# (la ventana siguiente empieza ahí). 0 = sin tope. Por defecto: 0.
BATCH_MAX_EVENTS=0

# Jails cuyos bans saltan el lote y se envían al instante (formato de
# siempre). Esos eventos NO se recuentan después en el resumen. Opcional.
NOTIFY_INSTANT_JAILS=

# Cómo tratar los unbans en el resumen: "count" (solo recuento),
# "off" (se omiten; si solo hubo unbans no se envía nada) o "list" (como
# "count" y, si BATCH_SHOW_IPS=true, añade también las IPs desbloqueadas).
NOTIFY_UNBANS=count

# ── Contador (persistencia) ──────────────────────────────────
# Backend del contador: "file" (JSON, sin dependencias) o "postgres".
# Por defecto: file. El backend postgres requiere instalar el paquete opcional
# `pg` (pnpm add pg).
COUNTER_BACKEND=file

# Ruta del fichero JSON del contador (COUNTER_BACKEND=file).
# Por defecto: ./data/f2b-counter.json
COUNTER_FILE=./data/f2b-counter.json

# Conexión PostgreSQL (solo COUNTER_BACKEND=postgres). Reutiliza la tabla
# heredada `f2b_stats` (columnas count/last/total_bans/weekly).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=f2b
DB_USER=f2b
DB_PASSWORD=

# ── Logging ──────────────────────────────────────────────────
# Nivel: debug | info | warn | error. Por defecto: info.
LOG_LEVEL=info

# Fichero de log opcional (append). Vacío por defecto: solo stdout/stderr,
# que systemd/journald captura. Si se define, además se anexa a este fichero.
LOG_FILE=
